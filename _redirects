# ══════════════════════════════════════════════════════════
#  Casca — Cloudflare Pages Redirects
#  Replaces netlify.toml [[redirects]] for SPA routing
#
#  NOTE: /api/* proxy is handled by functions/api/[[path]].js
#        /health proxy is handled by functions/health.js
# ══════════════════════════════════════════════════════════

# SPA Routing — clean URLs → actual HTML files
/admin          /casca-admin.html       200
/admin/*        /casca-admin.html       200
/dashboard      /casca-dashboard.html   200
/annotator      /casca-annotator.html   200
/docs/zapier    /casca-api-docs.html    200
/gate           /gate/                  301
# AIShutter (2026-10-22 renamed; updates feed stays until the desktop updater moves)
/shutter/updates/*  /shutter/updates/:splat  200
/shutter            /aishutter/              301
/shutter/*          /aishutter/:splat        301
/aishutter          /aishutter/              301
/aishutter/support  /aishutter/support/      301
/aishutter/privacy  /aishutter/privacy/      301
# 2026-10-22 site restyle A: old pages folded into the new home / gate
/tw.html            /                        301
/tw                 /                        301
/terminal.html      /gate/                   301
/terminal           /gate/                   301
/airoute            /airoute/                301
# 2026-11-02 全站預設英文:根 = 英文、中文在 /zh/;舊 /en/ 網址 301 回根(契約 2026-11-02_cascaio-default-english)
/en                 /                        301
/en/*               /:splat                  301
/zh                 /zh/                     301
/zh/aishutter       /zh/aishutter/           301
/zh/aishutter/support  /zh/aishutter/support/  301
/zh/airoute         /zh/airoute/             301
